{% extends 'base.html.twig' %}

{% block title %}Shopping Cart - Our Store{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="mb-4">Shopping Cart</h1>

        {% if cart.items is empty %}
            <div class="card">
                <div class="card-body text-center py-5">
                    <h5 class="card-title">Your cart is empty</h5>
                    <p class="text-muted">Add products from the catalog and they will appear here.</p>
                    <a href="{{ path('app_home') }}" class="btn btn-primary">Continue Shopping</a>
                </div>
            </div>
        {% else %}
            <div class="row">
                <div class="col-lg-8">
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th scope="col">Product</th>
                                            <th scope="col">Price</th>
                                            <th scope="col">Quantity</th>
                                            <th scope="col">Total</th>
                                            <th scope="col"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in cart.items %}
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="{{ asset(row.product.image ?: 'images/thumbnail.png') }}" class="img-thumbnail me-3" alt="{{ row.product.name }}" style="width: 80px; height: 80px; object-fit: cover;">
                                                        <div>
                                                            <h6 class="mb-0">{{ row.product.name }}</h6>
                                                            <small class="text-muted">{{ row.product.category.name }}</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>${{ row.unitPrice|number_format(2, '.', ',') }}</td>
                                                <td>{{ row.quantity }}</td>
                                                <td class="fw-bold">${{ row.lineTotal|number_format(2, '.', ',') }}</td>
                                                <td>
                                                    <form method="post" action="{{ path('app_cart_remove', {id: row.product.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('remove-from-cart-' ~ row.product.id) }}">
                                                        <button class="btn btn-sm btn-outline-danger">Remove</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="{{ path('app_home') }}" class="btn btn-outline-primary">Continue Shopping</a>
                        <form method="post" action="{{ path('app_cart_clear') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('clear-cart') }}">
                            <button class="btn btn-outline-danger">Clear Cart</button>
                        </form>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Order Summary</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Items:</span>
                                <span>{{ cart.totalQuantity }}</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal:</span>
                                <span>${{ cart.total|number_format(2, '.', ',') }}</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Shipping:</span>
                                <span>Calculated at checkout</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-3">
                                <strong>Total:</strong>
                                <strong class="text-success">${{ cart.total|number_format(2, '.', ',') }}</strong>
                            </div>
                            <div class="d-grid">
                                <button class="btn btn-success btn-lg" type="button">Proceed to Checkout</button>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-body">
                            <h6 class="card-title">Have a promo code?</h6>
                            <form>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Enter code">
                                    <button class="btn btn-outline-secondary" type="submit">Apply</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
