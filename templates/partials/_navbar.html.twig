{% set current_route = app.request.attributes.get('_route')|default('') %}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">Our Store</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link {{ current_route == 'app_home' ? 'active' }}" href="{{ path('app_home') }}">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ current_route in ['app_categories', 'app_category_show'] ? 'active' }}" href="{{ path('app_categories') }}">Categories</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ current_route starts with 'app_cart' ? 'active' }}" href="{{ path('app_cart') }}">Cart</a>
                </li>
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link {{ current_route == 'app_profile' ? 'active' }}" href="{{ path('app_profile') }}">Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link {{ current_route == 'app_login' ? 'active' }}" href="{{ path('app_login') }}">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ current_route == 'app_register' ? 'active' }}" href="{{ path('app_register') }}">Register</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
