{% extends 'base.html.twig' %}

{% block title %}Products - Our Store{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="mb-1">Our Products</h1>
                <p class="text-muted mb-0">Fresh picks from the catalog, powered by Doctrine data.</p>
            </div>
            <a href="{{ path('app_categories') }}" class="btn btn-primary">Browse Categories</a>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for product in products %}
                {% include 'partials/_product_card.html.twig' with {product: product} only %}
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">No products are available yet. Load the fixtures to populate the store.</div>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="bg-light py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-6 fw-bold">Shop by Category</h2>
                <p class="text-muted">Explore our wide range of products organized by category</p>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                {% for category in categories|slice(0, 6) %}
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            {% if category.image %}
                                <img src="{{ asset(category.image) }}" class="card-img-top category-card-img" alt="{{ category.name }}">
                            {% endif %}
                            <div class="card-body text-center">
                                <span class="badge bg-primary mb-2">{{ category.products|length }} Products</span>
                                <h4 class="card-title">{{ category.name }}</h4>
                                <p class="card-text text-muted">{{ category.description }}</p>
                                <a href="{{ path('app_category_show', {slug: category.slug}) }}" class="btn btn-outline-primary">Browse {{ category.name }}</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
